# Public client-side Supabase values only (safe to expose with correct RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Never put SUPABASE_SERVICE_ROLE_KEY or payment provider secrets in VITE_ variables.
# Configure service role/provider secrets only in Supabase Edge Function secrets.
